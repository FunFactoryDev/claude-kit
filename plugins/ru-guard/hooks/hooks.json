{
  "description": "ru-guard: не даёт Claude править .env и lock-файлы через Edit и Write",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-files.mjs\""
          }
        ]
      }
    ]
  }
}
